# Analytics — IDs públicos (no secretos). Vacío = servicio inactivo.
# En producción se configuran en Vercel → Settings → Environment Variables.
# Detalle en docs/ANALYTICS.md. Nunca pongas secretos en variables VITE_*.

# LinkedIn Insight Tag (Partner ID)
VITE_LINKEDIN_PARTNER_ID=

# Google Tag Manager (GTM-XXXXXXX) — preparado, inactivo
VITE_GTM_ID=

# Google Analytics 4 (G-XXXXXXXXXX) — preparado, inactivo
VITE_GA4_MEASUREMENT_ID=

# Formulario de contacto (api/leads.ts). Detalle en docs/CONTACT-FORM.md.
# Pública: Cloudflare Turnstile site key (va al bundle; se necesita al hacer el build).
VITE_TURNSTILE_SITE_KEY=

# Solo servidor (Vercel Function). Nunca con prefijo VITE_.
TURNSTILE_SECRET_KEY=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=contacto@shopitrack.com
# Opcional: segundo destinatario de respaldo. Solo servidor; no se muestra en el sitio.
CONTACT_EMAIL_BACKUP=
